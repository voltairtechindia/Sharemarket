--- a/assets/style.css
+++ b/assets/style.css
@@ -460,14 +460,26 @@ body { display: flex; flex-direction: column; overflow: hidden; }
 @media (max-width: 1280px) {
   :root { --insight-w: 280px; --mw-w: 240px; }
 }
+/* Between 760 and 1080 the third column will not fit beside the chart, so it
+   moves under it instead of disappearing. Hiding the forecast entirely made
+   the page look broken on a laptop - it is the reason the page exists. */
 @media (max-width: 1080px) {
-  .workspace { grid-template-columns: var(--mw-w) minmax(0,1fr); }
