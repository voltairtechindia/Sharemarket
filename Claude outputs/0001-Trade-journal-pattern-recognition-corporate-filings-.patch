+  .workspace {
+    grid-template-columns: var(--mw-w) minmax(0,1fr);
+    grid-template-rows: minmax(0, 1fr) auto;
   }
+  .mw-panel      { grid-column: 1; grid-row: 1 / span 2; }
+  .chart-panel   { grid-column: 2; grid-row: 1; }
+  .insight-panel {
+    display: flex; grid-column: 2; grid-row: 2;
+    max-height: 34vh; border-top: 1px solid var(--border);
+  }
+  /* The forecast reads better as a row than a column at this width. */
+  .insight-panel .panel-scroll {
+    display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
+    align-items: start;
+  }
+  .insight-panel .section { border-right: 1px solid var(--border); }
 }
 @media (max-width: 860px) {
   /* The topbar is the only row that cannot wrap, so shrink it deliberately
@@ -527,3 +539,52 @@ body { display: flex; flex-direction: column; overflow: hidden; }
    only things allowed to scroll sideways are their own containers. */
 html, body { max-width: 100%; overflow-x: clip; }
 .news-head-text, .sector-n, .mw-title, .driver-k { min-width: 0; }
+
+
+/* ------------------------------------------------------------- journal */
+.journal-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; }
+.journal-table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); }
+.journal-table { width: 100%; border-collapse: collapse; font-size: 12px; }
+.journal-table th {
+  text-align: left; font-size: 9.5px; letter-spacing: .06em; text-transform: uppercase;
+  color: var(--ink-muted); font-weight: 600; padding: 7px 9px;
+  border-bottom: 1px solid var(--border); background: var(--bg-sunken); white-space: nowrap;
+}
+.journal-table td { padding: 7px 9px; border-bottom: 1px solid var(--border); vertical-align: middle; }
+.journal-table tr:last-child td { border-bottom: none; }
+.journal-table .num-col { text-align: right; font-family: var(--mono); }
+.journal-table .side-buy  { color: var(--brand); font-weight: 600; }
+.journal-table .side-sell { color: var(--down); font-weight: 600; }
+.journal-table .row-del {
+  border: none; background: none; color: var(--ink-faint); cursor: pointer;
+  font-size: 15px; line-height: 1; padding: 2px 5px; border-radius: 3px;
+}
+.journal-table .row-del:hover { color: var(--down); background: var(--down-soft); }
+.journal-empty { padding: 18px; text-align: center; color: var(--ink-muted); font-size: 12px; }
+
+/* --------------------------------------------------- pattern recognition */
+.pattern-now { display: grid; gap: 5px; margin-bottom: 9px; }
+.pattern-live {
+  display: flex; align-items: center; justify-content: space-between;
+  gap: 8px; font-size: 11px;
+}
+.pattern-table { width: 100%; border-collapse: collapse; font-size: 11.5px; }
+.pattern-table th {
+  text-align: left; font-size: 9px; letter-spacing: .06em; text-transform: uppercase;
+  color: var(--ink-muted); font-weight: 600; padding: 5px 4px;
+  border-bottom: 1px solid var(--border); white-space: nowrap;
+}
+.pattern-table td { padding: 5px 4px; border-bottom: 1px dashed var(--border); }
+.pattern-table tr:last-child td { border-bottom: none; }
+.pattern-table .num-col { text-align: right; font-family: var(--mono); }
+/* A thin sample is shown, but visibly demoted - it is not evidence. */
+.pattern-table tr.thin td { opacity: .55; }
+.thin-tag {
+  font-size: 8.5px; letter-spacing: .05em; text-transform: uppercase;
+  color: var(--warn); border: 1px solid var(--warn); border-radius: 2px;
+  padding: 0 3px; vertical-align: middle;
+}
+.pattern-note {
+  font-size: 10px; line-height: 1.45; color: var(--ink-faint);
+  margin: 8px 0 0; border-top: 1px dashed var(--border); padding-top: 7px;
+}
